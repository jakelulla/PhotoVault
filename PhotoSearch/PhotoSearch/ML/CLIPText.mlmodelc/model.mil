            tensor<fp16, [512]> p_ln_final_bias_to_fp16 = const()[name = tensor<string, []>("p_ln_final_bias_to_fp16"), val = tensor<fp16, [512]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(126352320)))];
            tensor<fp16, []> const_493_to_fp16 = const()[name = tensor<string, []>("const_493_to_fp16"), val = tensor<fp16, []>(0x1.5p-17)];
            tensor<fp16, [1, 77, 512]> layer_norm_24_cast_fp16 = layer_norm(axes = layer_norm_24_axes_0, beta = p_ln_final_bias_to_fp16, epsilon = const_493_to_fp16, gamma = p_ln_final_weight_to_fp16, x = add_24_cast_fp16)[name = tensor<string, []>("layer_norm_24_cast_fp16")];
            tensor<int32, []> argmax_axis_0 = const()[name = tensor<string, []>("argmax_axis_0"), val = tensor<int32, []>(-1)];
            tensor<bool, []> argmax_keep_dims_0 = const()[name = tensor<string, []>("argmax_keep_dims_0"), val = tensor<bool, []>(false)];
            tensor<int32, [1]> argmax = reduce_argmax(axis = argmax_axis_0, keep_dims = argmax_keep_dims_0, x = tokens)[name = tensor<string, []>("argmax")];
            tensor<int32, [1]> arange = const()[name = tensor<string, []>("arange"), val = tensor<int32, [1]>([0])];
            tensor<int32, []> stack_0_axis_0 = const()[name = tensor<string, []>("stack_0_axis_0"), val = tensor<int32, []>(1)];
            tensor<int32, [1, 2]> stack_0 = stack(axis = stack_0_axis_0, values = (arange, argmax))[name = tensor<string, []>("stack_0")];
