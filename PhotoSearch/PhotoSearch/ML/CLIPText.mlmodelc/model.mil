            tensor<fp16, [512, 512]> transpose_1_1_to_fp16 = const()[name = tensor<string, []>("transpose_1_1_to_fp16"), val = tensor<fp16, [512, 512]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(126353408)))];
            tensor<fp16, [512]> matmul_bias_0_to_fp16 = const()[name = tensor<string, []>("matmul_bias_0_to_fp16"), val = tensor<fp16, [512]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(126877760)))];
            tensor<fp16, [1, 512]> matmul_cast_fp16 = linear(bias = matmul_bias_0_to_fp16, weight = transpose_1_1_to_fp16, x = index_transpose_cast_fp16)[name = tensor<string, []>("matmul_cast_fp16")];
            tensor<int32, [1]> const_501 = const()[name = tensor<string, []>("const_501"), val = tensor<int32, [1]>([-1])];
