            tensor<fp16, [1, 1]> linalg_vector_norm_cast_fp16 = reduce_l2_norm(axes = const_501, keep_dims = const_502, x = matmul_cast_fp16)[name = tensor<string, []>("linalg_vector_norm_cast_fp16")];
            tensor<fp16, [1, 512]> text_features = real_div(x = matmul_cast_fp16, y = linalg_vector_norm_cast_fp16)[name = tensor<string, []>("div_cast_fp16")];
        } -> (text_features);
}