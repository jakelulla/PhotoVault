<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for iOS to route a tapped iCloud/CloudKit share link (from
	     Messages, Mail, etc.) to this installed app. Without it iOS assumes the
	     app can't handle the share and offers to update it from the App Store. -->
	<key>CKSharingSupported</key>
	<true/>
	<!-- Deep-link scheme for the widget ("photovault://shared" opens the
	     Shared Albums screen via ContentView's onOpenURL). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jakelulla.PhotoSearch</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>photovault</string>
			</array>
		</dict>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.photosearch.index</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
